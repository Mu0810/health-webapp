# Copy to .env and fill in values.

# Database (Prisma + libSQL adapter).
# Local dev: a SQLite file. Production: a hosted libSQL/Turso URL
# (e.g. libsql://your-db.turso.io) plus DATABASE_AUTH_TOKEN.
DATABASE_URL="file:./dev.db"
# DATABASE_AUTH_TOKEN=""   # required for remote Turso, omit for local file

# OpenRouter API key — powers /api/vision (food photo analysis) and
# /api/diet-plan (7-day meal plans). Defaults to free models.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Optional: override the model fallback chains (comma-separated, priority order).
# The client tries each in order and skips any that are rate-limited/unavailable.
# Vision models MUST support image input.
# OPENROUTER_VISION_MODELS="google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free"
#
# For the diet plan (a large 7-day JSON), free models are often rate-limited or
# too slow to finish within the serverless time limit. For reliable results put
# a fast model first; openai/gpt-4o-mini finishes in ~20s for ~$0.002/plan:
# OPENROUTER_TEXT_MODELS="openai/gpt-4o-mini,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-next-80b-a3b-instruct:free"
# Strictly-free (best-effort) alternative:
# OPENROUTER_TEXT_MODELS="meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-120b:free"

# Optional: sent as HTTP-Referer to OpenRouter for app attribution/ranking.
# OPENROUTER_SITE_URL="https://your-app.vercel.app"
