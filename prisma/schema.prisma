// Healthvibe database schema.
// No auth yet — records are keyed by a client-generated device id so a
// browser keeps its own profile + food logs across refreshes/devices-sync-later.
// Local dev uses SQLite; production points DATABASE_URL at a hosted DB
// (Turso/libSQL keeps this same `sqlite` provider; Neon/Postgres would swap it).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id // client-generated device id
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profile   Profile?
  foods     FoodLog[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  age            Int
  gender         String
  weightKg       Float
  heightCm       Float
  activityLevel  String
  goal           String
  dietType       String
  // Computed targets
  bmi            Float
  bmr            Float
  tdee           Float
  targetCalories Float
  targetProtein  Float
  targetCarbs    Float
  targetFats     Float
  ffm            Float
  updatedAt      DateTime @updatedAt
}

model FoodLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  calories      Float
  protein       Float
  carbs         Float
  fats          Float
  glycemicIndex Float?
  timestamp     DateTime @default(now())

  @@index([userId, timestamp])
}
